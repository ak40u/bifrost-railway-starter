{
  "$schema": "https://www.getbifrost.ai/schema",
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.PGHOST",
      "port": "env.PGPORT",
      "user": "env.PGUSER",
      "password": "env.PGPASSWORD",
      "db_name": "env.PGDATABASE",
      "ssl_mode": "disable"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.PGHOST",
      "port": "env.PGPORT",
      "user": "env.PGUSER",
      "password": "env.PGPASSWORD",
      "db_name": "env.PGDATABASE",
      "ssl_mode": "disable"
    }
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "disable_auth_on_inference": false
    }
  }
}
